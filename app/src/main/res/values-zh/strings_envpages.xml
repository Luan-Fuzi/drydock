    <string name="endpoint_title">Coding 端点</string>
    <string name="endpoint_intro">自定义端点列表（写进 opencode/pi 的配置文件）。内置目录厂商不需要在这——往 ~/.drydock/env.sh 放标准变量名即自动识别（GLM Coding Plan 用 ZHIPU_API_KEY）</string>
    <string name="endpoint_empty">（暂无自定义端点）</string>
